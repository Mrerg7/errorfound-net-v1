---
import {
  categoryLabel,
  lengthBand,
  priceLabel,
  slugFor,
  tldOf,
  type DomainListing,
} from "../data/inventory";

interface Props {
  domain: DomainListing;
}
const { domain } = Astro.props;
const slug = slugFor(domain.name);
const hay = [domain.name, domain.tagline, domain.summary, domain.category, ...domain.keywords, ...domain.uses]
  .join(" ")
  .toLowerCase();
---

<article
  class="domain-card flex flex-col rounded-2xl border border-line bg-surface p-5"
  data-name={domain.name}
  data-category={domain.category}
  data-tld={tldOf(domain.name)}
  data-price={domain.price ?? ""}
  data-len={lengthBand(domain.name)}
  data-text={hay}
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-medium tracking-widest text-muted uppercase">
      .{tldOf(domain.name)} · {categoryLabel(domain.category)}
    </p>
    <button
      type="button"
      class="js-save inline-flex size-12 items-center justify-center rounded-full text-muted"
      data-save={domain.name}
      aria-pressed="false"
      aria-label={`Save ${domain.name}`}
    >
      Save
    </button>
  </div>
  <h3 class="font-display text-2xl tracking-tight text-fg">
    <a class="hover:text-accent-2" href={`/domains/${slug}/`}>{domain.name}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{domain.tagline}</p>
  <div class="mt-5 flex items-center justify-between gap-3">
    <p class="text-lg font-medium text-fg">{priceLabel(domain.price)}</p>
    <a class="inline-flex min-h-12 items-center rounded-full border border-line px-4 text-sm text-fg hover:border-accent-2" href={`/domains/${slug}/`}>
      View name
    </a>
  </div>
</article>

---
const links = [
  { href: "/domains/", label: "Marketplace" },
  { href: "/insights/", label: "Insights" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4">
    <a href="/" class="flex min-h-12 items-center gap-2" aria-label="ErrorFound home">
      <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true">
        <circle cx="16" cy="16" r="15" fill="var(--color-surface-2)"></circle>
        <path d="M16 5.5 18.1 8.4 21.4 7.6 21.6 11 24.8 12.4 22.8 15 24.8 17.6 21.6 19 21.4 22.4 18.1 21.6 16 24.5 13.9 21.6 10.6 22.4 10.4 19 7.2 17.6 9.2 15 7.2 12.4 10.4 11 10.6 7.6 13.9 8.4Z" fill="var(--color-muted)"></path>
        <circle cx="15" cy="15" r="4.2" fill="none" stroke="var(--color-accent-2)" stroke-width="1.7"></circle>
        <path d="M18.1 18.1 21.2 21.2" stroke="var(--color-accent-2)" stroke-width="1.7" stroke-linecap="round"></path>
        <path d="M16 8.2 17.4 12.6 14.2 13.8Z" fill="var(--color-accent)"></path>
      </svg>
      <span class="font-display text-xl leading-none tracking-tight text-fg">
        <span class="text-accent">Error</span>Found
      </span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((item) => (
        <a href={item.href} class="inline-flex min-h-12 items-center rounded-full px-3 text-sm text-muted hover:text-fg">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      <button type="button" id="theme-toggle" class="inline-flex size-12 items-center justify-center rounded-full text-fg hover:bg-surface-2" aria-label="Switch color theme">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
        </svg>
      </button>
      <a href="/contact/?domain=errorfound.net&intent=offer" class="hidden min-h-12 items-center rounded-full bg-accent px-4 text-sm font-medium text-on-accent sm:inline-flex">
        Make offer
      </a>
      <button type="button" id="nav-toggle" class="inline-flex size-12 items-center justify-center rounded-full text-fg md:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        Menu
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-line px-4 py-2 md:hidden" aria-label="Mobile">
    {links.map((item) => (
      <a href={item.href} class="flex min-h-12 items-center text-base text-fg">{item.label}</a>
    ))}
    <a href="/contact/?domain=errorfound.net&intent=offer" class="mb-2 flex min-h-12 items-center text-base font-medium text-accent">Make offer</a>
  </nav>
</header>

---
import Layout from "../layouts/Layout.astro";
import Inquiry from "../components/Inquiry.astro";

const title = "Contact the agent | ErrorFound";
const description =
  "Contact the ErrorFound domain agent at erg@errorfound.net. Make an offer, start a buy request, or ask about an escrow transfer.";
---

<Layout title={title} description={description}>
  <main id="content" class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-2">
    <div>
      <p class="text-sm text-muted"><a class="hover:text-fg" href="/">Home</a> / Contact</p>
      <h1 class="mt-3 font-display text-4xl tracking-tight text-fg sm:text-5xl">Contact the agent</h1>
      <p class="mt-3 max-w-md leading-relaxed text-muted">
        Write from here or email erg@errorfound.net directly. Include the exact domain, your number, and whether you need a registrar push or an auth-code transfer.
      </p>
      <dl class="mt-8 grid gap-4 text-sm">
        <div>
          <dt class="text-muted">Email</dt>
          <dd><a class="text-lg text-fg" href="mailto:erg@errorfound.net">erg@errorfound.net</a></dd>
        </div>
        <div>
          <dt class="text-muted">Desk</dt>
          <dd class="text-lg text-fg">Phoenix, Arizona</dd>
        </div>
      </dl>
    </div>
    <Inquiry intent="contact" />
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import DomainCard from "../components/DomainCard.astro";
import { ARTICLES, CATEGORIES, HERO, LISTINGS, SITE } from "../data/inventory";

const featured = LISTINGS.filter((d) => d.featured);
const title = "errorfound.net | Premium Domain for Sale | ErrorFound";
const description =
  "errorfound.net is a premium domain for sale. Make an offer or browse the ErrorFound marketplace for technology, security, health, and brandable names. Escrow-protected transfer.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "ErrorFound",
    url: SITE.url,
    email: SITE.email,
    image: HERO,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Phoenix",
      addressRegion: "AZ",
      addressCountry: "US",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "ErrorFound",
    url: SITE.url,
    description: "Premium domain marketplace. errorfound.net is available by offer.",
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/domains/?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
---

<Layout title={title} description={description} image={HERO} jsonLd={jsonLd} preloadImage>
  <main id="content">
    <section class="relative min-h-[calc(100dvh-4rem)] overflow-hidden bg-ink text-paper">
      <img
        src={HERO}
        alt="ErrorFound metal sign on a brick server-room wall: steel gear, blue magnifier, red fault mark."
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-center"
      />
      <div class="hero-scrim absolute inset-0"></div>
      <div class="hero-veil absolute inset-0"></div>
      <div class="grain absolute inset-0"></div>
      <div class="relative mx-auto flex min-h-[calc(100dvh-4rem)] max-w-6xl flex-col justify-end px-4 py-12 sm:py-16">
        <p class="text-xs font-medium tracking-widest text-paper/80 uppercase">Premium domain for sale</p>
        <h1 class="mt-3 max-w-3xl font-display text-5xl leading-none tracking-tight text-paper sm:text-7xl">errorfound.net</h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-paper/85 sm:text-lg">
          A precise, ownable .net for teams who find what breaks. One registration. No auction clock. Transfer closes through escrow.
        </p>
        <p class="mt-5 font-display text-3xl text-paper">Make an offer</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/?domain=errorfound.net&intent=offer" class="inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-on-accent">Make offer</a>
          <a href="/contact/?domain=errorfound.net&intent=contact" class="inline-flex min-h-12 items-center justify-center rounded-full border border-paper/30 bg-ink/40 px-5 text-sm font-medium text-paper">Contact agent</a>
          <a href="/domains/" class="inline-flex min-h-12 items-center justify-center rounded-full px-5 text-sm font-medium text-paper underline-offset-4 hover:underline">Browse the portfolio</a>
        </div>
        <ul class="mt-8 flex flex-col gap-3 text-sm text-paper/80 sm:flex-row sm:gap-6">
          <li>Escrow, not a personal wire</li>
          <li>Only one registration exists</li>
          <li>HTTPS on the live site</li>
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-3xl tracking-tight text-fg sm:text-4xl">Names in the portfolio</h2>
          <p class="mt-2 max-w-xl text-muted">Technology, security, health, geography, and brandables. Filter the full list when you know the extension or the budget.</p>
        </div>
        <a href="/domains/" class="hidden min-h-12 items-center text-sm text-accent-2 sm:inline-flex">All {LISTINGS.length} names</a>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((domain) => <DomainCard domain={domain} />)}
      </div>
    </section>

    <section class="border-y border-line bg-surface">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-3xl tracking-tight text-fg sm:text-4xl">Why buyers ask about errorfound.net</h2>
          <p class="mt-3 text-muted">The name already sits on a live HTTPS site. You are buying the registration, not a template.</p>
        </div>
        <ul class="grid gap-4">
          <li class="rounded-2xl border border-line bg-bg p-5">
            <h3 class="text-lg font-medium text-fg">It says the job</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">Find the error. No coined syllable to teach a sales team.</p>
          </li>
          <li class="rounded-2xl border border-line bg-bg p-5">
            <h3 class="text-lg font-medium text-fg">It is a .net on purpose</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">Technical buyers still read .net as infrastructure, not a blog.</p>
          </li>
          <li class="rounded-2xl border border-line bg-bg p-5">
            <h3 class="text-lg font-medium text-fg">It transfers cleanly</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">Agree a number, open escrow, push or auth-code, then funds move.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="font-display text-3xl tracking-tight text-fg sm:text-4xl">Browse by category</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {CATEGORIES.map((category) => (
          <a href={`/domains/?category=${category.id}`} class="inline-flex min-h-12 items-center rounded-full border border-line bg-surface px-4 text-sm text-fg hover:border-accent-2">
            {category.label}
          </a>
        ))}
      </div>
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        <li class="rounded-2xl border border-line p-5">
          <p class="font-display text-3xl text-accent">1</p>
          <h3 class="mt-2 text-lg font-medium text-fg">Choose the name</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">Open a listing or filter by price, TLD, and length.</p>
        </li>
        <li class="rounded-2xl border border-line p-5">
          <p class="font-display text-3xl text-accent">2</p>
          <h3 class="mt-2 text-lg font-medium text-fg">Send a number</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">Make an offer, or accept the asking price where one is published.</p>
        </li>
        <li class="rounded-2xl border border-line p-5">
          <p class="font-display text-3xl text-accent">3</p>
          <h3 class="mt-2 text-lg font-medium text-fg">Close in escrow</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">The agent coordinates the registrar transfer. You confirm control first.</p>
        </li>
      </ol>
    </section>

    <section class="border-t border-line bg-surface">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="flex items-end justify-between gap-4">
          <h2 class="font-display text-3xl tracking-tight text-fg sm:text-4xl">From the desk</h2>
          <a href="/insights/" class="inline-flex min-h-12 items-center text-sm text-accent-2">All notes</a>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {ARTICLES.map((article) => (
            <article class="rounded-2xl border border-line bg-bg p-5">
              <p class="text-xs font-medium tracking-widest text-muted uppercase">{article.kicker}</p>
              <h3 class="mt-2 font-display text-2xl leading-tight text-fg">
                <a class="hover:text-accent-2" href={`/insights/${article.slug}/`}>{article.title}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{article.description}</p>
              <p class="mt-4 text-xs text-muted">{article.date} · {article.minutes} min</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 py-16">
      <h2 class="font-display text-4xl tracking-tight text-fg">Ready when you are.</h2>
      <p class="max-w-xl text-muted">Flagship, or any name in the grid. The agent answers at {SITE.email}.</p>
      <a href="/domains/errorfound-net/" class="inline-flex min-h-12 items-center rounded-full bg-accent px-5 text-sm font-medium text-on-accent">Open errorfound.net</a>
    </section>
  </main>
</Layout>

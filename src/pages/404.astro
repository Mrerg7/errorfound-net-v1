---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | ErrorFound" description="That page is not on errorfound.net." noindex>
  <main id="content" class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-display text-4xl text-fg">Page not found</h1>
    <p class="mt-3 text-muted">The marketplace is still here.</p>
    <a href="/domains/" class="mt-6 inline-flex min-h-12 items-center text-accent-2">Browse names</a>
  </main>
</Layout>

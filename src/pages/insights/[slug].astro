---
import Layout from "../../layouts/Layout.astro";
import { ARTICLES, SITE, type Article } from "../../data/inventory";

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}
const { article } = Astro.props;
const title = `${article.title} | ErrorFound`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  author: { "@type": "Organization", name: "ErrorFound", url: SITE.url },
  publisher: { "@type": "Organization", name: "ErrorFound", url: SITE.url },
  mainEntityOfPage: `${SITE.url}/insights/${article.slug}/`,
};
---

<Layout title={title} description={article.description} jsonLd={jsonLd}>
  <main id="content" class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-sm text-muted">
      <a class="hover:text-fg" href="/">Home</a> /
      <a class="hover:text-fg" href="/insights/">Insights</a>
    </p>
    <p class="mt-4 text-xs font-medium tracking-widest text-muted uppercase">{article.kicker}</p>
    <h1 class="mt-2 font-display text-4xl leading-tight tracking-tight text-fg sm:text-5xl">{article.title}</h1>
    <p class="mt-3 text-sm text-muted">{article.date} · {article.minutes} min read</p>
    <div class="mt-8 grid gap-6">
      {article.blocks.map((block) => (
        <section>
          {block.heading && <h2 class="font-display text-2xl text-fg">{block.heading}</h2>}
          {block.paragraphs?.map((paragraph) => <p class="mt-3 leading-relaxed text-muted">{paragraph}</p>)}
          {block.list && (
            <ul class="mt-3 grid gap-2">
              {block.list.map((item) => <li class="rounded-2xl border border-line bg-surface px-4 py-3 text-fg">{item}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
    <p class="mt-10 text-sm text-muted">
      Looking at a specific name? <a class="text-accent-2" href="/domains/">Open the marketplace</a> or
      <a class="text-accent-2" href="/domains/errorfound-net/">the errorfound.net listing</a>.
    </p>
  </main>
</Layout>
